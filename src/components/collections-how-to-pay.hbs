<tr>
  <td style="padding: 34px {{brand.layout.horizontalPadding}} 10px;">
    <h2 style="margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 30px; font-weight: bold; line-height: 36px; color: {{brand.colors.headerText}};">
      How to pay your account
    </h2>
  </td>
</tr>
<tr>
  <td style="padding: 0 {{brand.layout.horizontalPadding}} 20px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: {{brand.collections.cardBackground}}; border-radius: 10px;">
      <tr>
        <td style="padding: 22px 22px 18px; font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}};">
          <p style="margin: 0 0 14px 0; font-weight: bold; color: {{brand.colors.headerText}};">Pay online</p>
          <p style="margin: 0 0 18px 0;">
            Open the <strong>{{brand.collections.toolboxLabel}}</strong> or hit <strong>“Pay Now”</strong> above and log in with your mobile or account number to pay online using credit/debit card, <strong>PayPal, Apple Pay, Google Pay</strong> or <strong>Alipay</strong>.
          </p>

          <p style="margin: 0 0 14px 0; font-weight: bold; color: {{brand.colors.headerText}};">Pay over the phone</p>
          <p style="margin: 0 0 18px 0;">
            Call <strong>{{brand.support.phone}}</strong> and pay by credit/debit card over the phone.
          </p>

          <p style="margin: 0 0 14px 0; font-weight: bold; color: {{brand.colors.headerText}};">Pay with BPAY&reg;</p>
          <p style="margin: 0 0 18px 0;">
            Use the <strong>Biller Code</strong> and <strong>Ref. number</strong> to pay via internet or phone banking services.
          </p>

          <p style="margin: 0 0 14px 0; font-weight: bold; color: {{brand.colors.headerText}};">Set up Direct Debit</p>
          <p style="margin: 0;">
            Once any overdue amount is paid, you can set up an automatic direct debit from your nominated account. Just call us on <strong>{{brand.support.phone}}</strong>.
          </p>
        </td>
      </tr>
    </table>
  </td>
</tr>
