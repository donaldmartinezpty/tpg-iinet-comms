<tr>
  <td style="padding: 0 {{brand.layout.horizontalPadding}} 20px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="background-color: {{brand.collections.cardBackground}}; border-radius: 10px;">
      <tr>
        <td style="padding: 20px 22px;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" class="two-column-table">
            <tr>
              <td class="two-column-left" width="54%" valign="top" style="padding-right: 16px;">
                <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
                  <tr>
                    <td width="42" valign="top" style="padding: 0 14px 14px 0;">
                      <img src="{{brand.collections.logoFooter}}" alt="{{brand.displayName}}" title="{{brand.displayName}}" width="41" style="display: block; max-width: 41px; height: auto;">
                    </td>
                    <td valign="top" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 12px; color: {{brand.colors.text}}; padding-bottom: 14px;">
                      Set up direct debit with a credit/debit card, bank account or <strong>PayPal</strong> via the <strong>{{brand.collections.toolboxLabel}}</strong> or visit <strong>{{brand.collections.payLabel}}</strong>
                    </td>
                  </tr>
                  <tr>
                    <td width="42" valign="top" style="padding: 0 14px 14px 0;">
                      <img src="{{brand.collections.phoneIcon}}" alt="Call {{brand.support.phone}}" title="Call {{brand.support.phone}}" width="32" height="32" style="display: block;">
                    </td>
                    <td valign="middle" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 12px; color: {{brand.colors.text}}; padding-bottom: 14px;">
                      Call <strong>{{brand.support.phone}}</strong> and pay by credit/debit card over the phone.
                    </td>
                  </tr>
                  <tr>
                    <td width="42" valign="top" style="padding: 0 14px 0 0;">
                      <img src="{{brand.quoteIcons.info}}" alt="Pay online" title="Pay online" width="32" height="32" style="display: block;">
                    </td>
                    <td valign="middle" style="font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 12px; color: {{brand.colors.text}};">
                      Pay online at <strong>{{brand.collections.payLabel}}</strong> or via the <strong>{{brand.collections.toolboxLabel}}</strong> using credit/debit card, <strong>PayPal, Apple Pay, Google Pay</strong> or <strong>Alipay</strong>.
                    </td>
                  </tr>
                </table>
              </td>
              <td class="two-column-right" width="46%" valign="top" style="padding-left: 16px;">
                <img src="img/bpay.png" alt="BPAY Biller Code 321 543 Ref 876 321 678 678" title="BPAY Biller Code 321 543 Ref 876 321 678 678" width="192" height="49" style="display: block; max-width: 100%; height: auto; margin-bottom: 14px;">
                <p style="margin: 0; font-family: Arial, Helvetica, sans-serif; font-size: 10px; line-height: 12px; color: {{brand.colors.text}};">
                  <strong>Mobile &amp; Internet Banking - BPAY&reg;</strong><br>
                  Contact your bank or financial institution to make this payment from your cheque, savings, debit, credit card or transaction account. More info: <strong>www.bpay.com.au</strong>
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </td>
</tr>
