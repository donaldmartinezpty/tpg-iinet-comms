{{> header title="Your Financial Hardship payment arrangement"}}

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}} 24px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="{{brand.layout.twoColumn.tableWidth}}" class="two-column-table" style="max-width: 100%;">
      <tr>
        <td class="two-column-left" width="{{brand.layout.twoColumn.leftWidth}}" valign="top" style="padding-right: {{brand.layout.twoColumn.gutter}}px;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Hi %%NAME%%,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Thanks for getting in touch with us about your account. As agreed, your payment schedule is as follows:
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          <strong>First payment:</strong> $%%FIRSTPAYAMOUNT%% due on %%DDMMYYYY%% and $%%INSTALLAMOUNT%% per month thereafter until the total arrangement balance of $%%TOTALARRGBAL%% is paid in full.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          The duration of the repayment plan will be for %%ARRANGEMENT_FREQUENCY_NUMBER_INSTALLS%% monthly instalments as per the agreed schedule.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          The above repayment schedule includes any Mobile or Accessory Payment Plan which will fall due during the payment schedule period.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          We appreciate your co-operation in bringing your account up to date. Please note that failure to adhere to this arrangement may result in further collection activities and/or service restrictions.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          If your circumstances change during this arrangement, you must advise us within 14 days of the change, and you may also seek a review of this arrangement.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Please call us on {{brand.collections.financialHardshipPhone}} between 9am to 5pm AEST, Monday to Friday if you are unable to make a payment on time or if your circumstances change.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Regards,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 18px; color: {{brand.colors.headerText}}; padding-bottom: 8px;">
          <strong>The {{brand.displayName}} Financial Hardship Team</strong>
        </td>
      </tr>
          </table>
        </td>
        <td class="two-column-right" width="{{brand.layout.twoColumn.rightWidth}}" valign="top" style="padding-left: {{brand.layout.twoColumn.gutter}}px;">
          {{> collections-account-box}}
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 0 {{brand.layout.horizontalPadding}} 38px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}};">
          Thanks,<br>
          The {{brand.displayName}} Team
        </td>
      </tr>
    </table>
  </td>
</tr>

{{> collections-how-to-pay}}
{{> collections-payment-slip}}

{{> collections-footer}}
