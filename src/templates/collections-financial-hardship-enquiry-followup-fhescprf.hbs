{{> header title="Follow-up for your Financial Hardship enquiry"}}

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}} 24px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="{{brand.layout.twoColumn.tableWidth}}" class="two-column-table" style="max-width: 100%;">
      <tr>
        <td class="two-column-left" width="{{brand.layout.twoColumn.leftWidth}}" valign="top" style="padding-right: {{brand.layout.twoColumn.gutter}}px;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Hi %%NAME%%,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          We’re following up on your recent financial hardship enquiry. As we have not yet received your submission, we are currently unable to assess your eligibility for assistance.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          If we do not hear from you within 10 business days, we will commence collections activities for any outstanding amount. You can make a payment by calling {{brand.support.phone}} or online at {{brand.oneAppUrl}}.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Should you have any questions or require assistance, please contact our team on
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          {{brand.collections.financialHardshipPhone}}. We’re here to help and happy to support you.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Regards,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          <br /><strong>The {{brand.displayName}} Financial Hardship Team</strong>
        </td>
      </tr>
          </table>
        </td>
        <td class="two-column-right" width="{{brand.layout.twoColumn.rightWidth}}" valign="top" style="padding-left: {{brand.layout.twoColumn.gutter}}px;">
          {{> collections-account-box}}
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 0 {{brand.layout.horizontalPadding}} 38px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}};">
          Thanks,<br>
          The {{brand.displayName}} Team
        </td>
      </tr>
    </table>
  </td>
</tr>

