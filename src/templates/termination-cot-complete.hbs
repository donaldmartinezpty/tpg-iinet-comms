{{> header}}

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}};">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td>
          <h1 style="-ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; color: {{brand.colors.headerText}}; font-family: Arial, Helvetica, sans-serif; font-size: 18px; font-weight: bold; line-height: 26px; margin: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding-bottom: 8px;">
            Your new internet service is online
          </h1>
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Hi %%NAME%%,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Your new {{brand.displayName}} internet service at %%INSTALLATION_ADDRESS%% is now connected, so we have switched off the old %%FORMER_INTERNET_WHOLESALER%% service at this address.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          We hope you enjoy your new %%NEW_INTERNET_WHOLESALER%% service. If you need any more information, feel free to call us on {{brand.support.phone}}.
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}} 60px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}};">
          Thanks,<br>
          Your {{brand.displayName}} Team
        </td>
      </tr>
    </table>
  </td>
</tr>

{{> footer}}
