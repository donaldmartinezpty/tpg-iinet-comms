{{> header}}

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}};">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td>
          <h1 style="-ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; color: {{brand.colors.headerText}}; font-family: Arial, Helvetica, sans-serif; font-size: 28px; font-weight: bold; line-height: 34px; margin: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding-bottom: 20px;">
            Your NumberSync is active
          </h1>
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Hi %%NAME%%,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          We've activated your {{brand.displayName}} NumberSync™ subscription for %%SECONDARY_DEVICE_IDENTIFIER%% on your mobile service %%MOBILE_NUMBER%%.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          For more info about {{brand.displayName}} NumberSync™, check out our %%SUPPORT_PAGE%%.
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}} 60px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}};">
          Thanks,<br>
          Your {{brand.displayName}} Team
        </td>
      </tr>
    </table>
  </td>
</tr>

{{> footer}}
