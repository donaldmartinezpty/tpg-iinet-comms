{{> header title="Your Financial Hardship payment arrangement"}}

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}} 24px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="{{brand.layout.twoColumn.tableWidth}}" class="two-column-table" style="max-width: 100%;">
      <tr>
        <td class="two-column-left" width="{{brand.layout.twoColumn.leftWidth}}" valign="top" style="padding-right: {{brand.layout.twoColumn.gutter}}px;">
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Hi %%NAME%%,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Thanks for getting in touch with us about your account. Here’s a confirmation of the payment arrangement on your account.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          The total amount payable under this payment arrangement is $ %%DCALCULATIONCOMMUNICATIONSL51ARRTOTALAMOUNTD%%.
        </td>
      </tr>
          </table>
        </td>
        <td class="two-column-right" width="{{brand.layout.twoColumn.rightWidth}}" valign="top" style="padding-left: {{brand.layout.twoColumn.gutter}}px;">
          {{> collections-account-box}}
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 0 {{brand.layout.horizontalPadding}} 24px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 14px; line-height: 18px; color: {{brand.colors.headerText}}; padding-bottom: 12px;">
          <strong>You have agreed to make the following instalment payments:</strong>
        </td>
      </tr>
      <tr>
        <td>
          <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%" style="border-collapse: collapse;">
            <tr>
              <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: bold; color: {{brand.colors.headerText}}; padding: 0 10px 8px 0; border-bottom: 2px solid {{brand.collections.cardBackground}};">Instalment No</td>
              <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: bold; color: {{brand.colors.headerText}}; padding: 0 10px 8px; border-bottom: 2px solid {{brand.collections.cardBackground}};">Instalment Due Date</td>
              <td style="font-family: Arial, Helvetica, sans-serif; font-size: 12px; line-height: 16px; font-weight: bold; color: {{brand.colors.headerText}}; padding: 0 0 8px 10px; border-bottom: 2px solid {{brand.collections.cardBackground}};">Instalment Amount</td>
            </tr>
            <tr>
              <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding: 10px 10px 0 0;">%%DCALCULATIONCOMMUNICATIONSLETTERINSTALMENTNOD%%</td>
              <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding: 10px 10px 0;">%%DCALCULATIONCOMMUNICATIONSLETTERINSTALMENTDUEDATED%%</td>
              <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding: 10px 0 0 10px;">$ %%DCALCULATIONCOMMUNICATIONSLETTERINSTALMENTAMOUNTD%%</td>
            </tr>
          </table>
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}}; padding-top: 20px;">
          The duration of the repayment plan will be for %%DCALCULATIONCOMMUNICATIONSL56ARRTOTALINSTALMENTSD%% instalments as per the agreed schedule.
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 0 {{brand.layout.horizontalPadding}} 38px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 13px; line-height: 17px; color: {{brand.colors.text}};">
          Thanks,<br>
          The {{brand.displayName}} Team
        </td>
      </tr>
    </table>
  </td>
</tr>

{{> collections-how-to-pay}}
{{> collections-payment-slip}}

{{> collections-footer}}
