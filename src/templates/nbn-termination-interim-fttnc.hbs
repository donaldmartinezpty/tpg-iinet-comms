{{> header}}

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}};">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td>
          <h1 style="-ms-text-size-adjust: 100%; -webkit-text-size-adjust: 100%; color: {{brand.colors.headerText}}; font-family: Arial, Helvetica, sans-serif; font-size: 28px; font-weight: bold; line-height: 34px; margin: 0; mso-table-lspace: 0pt; mso-table-rspace: 0pt; padding-bottom: 8px;">
            Your nbn® Fibre Upgrade is complete
          </h1>
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Hi %%NAME%%,
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          Your nbn® Fibre upgrade at %%INSTALLATION_ADDRESS%% is now connected, so we have switched off the old copper connection at this address.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          A credit has been applied to your account to cover the period when the Fibre and copper services were both active at this address.
        </td>
      </tr>
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}}; padding-bottom: 20px;">
          We hope you enjoy your new nbn® Fibre connection. If you need any more information, feel free to call us on {{brand.support.phone}}.
        </td>
      </tr>
    </table>
  </td>
</tr>

<tr>
  <td style="padding: 20px {{brand.layout.horizontalPadding}} 60px;">
    <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
      <tr>
        <td style="font-family: Arial, Helvetica, sans-serif; font-size: 16px; line-height: 24px; color: {{brand.colors.text}};">
          Thanks,<br>
          Your {{brand.displayName}} Team
        </td>
      </tr>
    </table>
  </td>
</tr>

{{> footer showThingsHeading=true showNbnTrademark=true}}
